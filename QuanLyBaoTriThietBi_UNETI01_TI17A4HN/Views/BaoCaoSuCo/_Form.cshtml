@* Họ tên: Trịnh Trung Hoàng | MSSV: 23103100229 | Lớp: TI17A4HN | Nhóm: UNETI01
   Module 4: Form nhập liệu Báo cáo sự cố dùng chung *@
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Models.Enums
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.BaoCaoSuCoFormViewModel
@{
    var mucDoOptions = Enum.GetValues<MucDoSuCoEnum>()
        .Select(v => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(UiHelper.Badge(v).Text, v.ToString()))
        .ToList();
}

<div class="mb-3">
    <label asp-for="MaThietBi" class="form-label required"></label>
    @if (Model.LaThemMoi)
    {
        <select asp-for="MaThietBi" asp-items="Model.ThietBiOptions" class="form-select">
            <option value="">-- Chọn thiết bị gặp sự cố --</option>
        </select>
        @if (!Model.ThietBiOptions.Any())
        {
            <div class="form-text">Không có thiết bị nào bạn được phép báo sự cố (chỉ thiết bị chưa ngừng sử dụng thuộc khu vực của bạn).</div>
        }
        <span asp-validation-for="MaThietBi" class="text-danger"></span>
    }
    else
    {
        @* Sửa: thiết bị bị khóa, chỉ hiển thị *@
        <input type="hidden" asp-for="MaThietBi" />
        <input class="form-control" readonly value="@(Model.ThietBiOptions.FirstOrDefault(o => o.Value == Model.MaThietBi?.ToString())?.Text)" />
        <div class="form-text">Không đổi được thiết bị sau khi đã gửi báo cáo. Nếu chọn nhầm, hãy hủy báo cáo và gửi lại.</div>
    }
</div>

<div class="mb-3">
    <label asp-for="MucDoSuCo" class="form-label required"></label>
    <select asp-for="MucDoSuCo" asp-items="mucDoOptions" class="form-select"></select>
    <span asp-validation-for="MucDoSuCo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="MoTaSuCo" class="form-label required"></label>
    <textarea asp-for="MoTaSuCo" class="form-control" rows="4" maxlength="500" placeholder="Mô tả hiện tượng: thiết bị bị gì, xảy ra khi nào, ảnh hưởng ra sao..."></textarea>
    <span asp-validation-for="MoTaSuCo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="GhiChu" class="form-label"></label>
    <textarea asp-for="GhiChu" class="form-control" rows="2" maxlength="500" placeholder="Ghi chú thêm (nếu có)..."></textarea>
    <span asp-validation-for="GhiChu" class="text-danger"></span>
</div>

@* STT 55: Tải lên ảnh chụp hiện trường sự cố *@
<div class="mb-4">
    <label asp-for="TepAnhDinhKem" class="form-label fw-semibold">
        <span class="material-symbols-outlined icon-18 me-1 align-middle text-primary">add_a_photo</span> Ảnh chụp hiện trường sự cố
    </label>
    <input asp-for="TepAnhDinhKem" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" />
    <div class="form-text">Có thể chọn nhiều tệp ảnh (.jpg, .png, .webp, tối đa 5MB/ảnh) chụp hiện trường hỏng hóc hoặc mã lỗi để kỹ thuật viên nắm rõ tình hình.</div>
    <span asp-validation-for="TepAnhDinhKem" class="text-danger"></span>
</div>
