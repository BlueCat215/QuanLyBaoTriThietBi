@* Họ tên: Nguyễn Văn Hoàng | MSSV: 23103100303   | Nội dung: Module 1 - Danh sách Tài khoản *@
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Models.Enums
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.TaiKhoanIndexViewModel
@{
    ViewData["Title"] = "Tài khoản";
}

<div class="page-header">
    <div>
        <h1>Tài khoản</h1>
        <p>Quản lý tài khoản người dùng, vai trò và trạng thái truy cập.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">Thêm tài khoản</a>
    </div>
</div>

@if (!Model.Items.Any() && !Model.CoBoLoc)
{
    <div class="card">
        <div class="card-body empty-state">
            <span class="material-symbols-outlined icon-24">group</span>
            <h3>Chưa có tài khoản nào</h3>
            <p>Hãy thêm tài khoản đầu tiên để bắt đầu.</p>
            <a class="btn btn-primary" asp-action="Create">Thêm tài khoản</a>
        </div>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="filter-bar">
        <div class="search">
            <label class="form-label" for="tuKhoa">Tìm kiếm</label>
            <input id="tuKhoa" name="tuKhoa" value="@Model.TuKhoa" class="form-control" placeholder="Nhập tên đăng nhập, họ tên hoặc email" />
        </div>
        <div>
            <label class="form-label" for="vaiTro">Vai trò</label>
            <select id="vaiTro" name="vaiTro" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var v in Enum.GetValues<VaiTroEnum>())
                {
                    <option value="@v" selected="@(Model.VaiTro == v)">@UiHelper.Badge(v).Text</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="trangThai">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả</option>
                <option value="true" selected="@(Model.TrangThai == true)">Hoạt động</option>
                <option value="false" selected="@(Model.TrangThai == false)">Bị khóa</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            @if (Model.CoBoLoc)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Xóa bộ lọc</a>
            }
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="card-body empty-state">
                <span class="material-symbols-outlined icon-24">search_off</span>
                <h3>Không tìm thấy tài khoản phù hợp</h3>
                <p>Hãy thử đổi từ khóa hoặc bỏ bớt bộ lọc.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Khu vực</th>
                        <th>Trạng thái</th>
                        <th>Đăng nhập gần nhất</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var laChinhMinh = Model.MaTaiKhoanHienTai == item.MaTaiKhoan;
                        <tr class="@(item.TrangThai ? "" : "is-muted")">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar">@UiHelper.VietTat(item.HoTen)</span>
                                    <div>
                                        <div class="cell-title">@item.HoTen</div>
                                        <div class="cell-sub mono">@item.TenDangNhap</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td><partial name="_StatusBadge" model="UiHelper.Badge(item.VaiTro)" /></td>
                            <td>@(string.IsNullOrEmpty(item.TenKhuVuc) ? "—" : item.TenKhuVuc)</td>
                            <td>
                                <partial name="_StatusBadge" model="UiHelper.BadgeHoatDong(item.TrangThai, true)" />
                                @if (item.TrangThai && item.KhoaDenNgay.HasValue && item.KhoaDenNgay > DateTime.Now)
                                {
                                    <div class="cell-sub">Tạm khóa đến @UiHelper.NgayGio(item.KhoaDenNgay)</div>
                                }
                            </td>
                            <td>@UiHelper.NgayGio(item.LanDangNhapCuoi)</td>
                            <td>
                                <div class="row-actions">
                                    @if (item.TrangThai)
                                    {
                                        <a class="btn btn-ghost btn-icon" asp-action="Edit" asp-route-id="@item.MaTaiKhoan" title="Sửa tài khoản">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>
                                    }
                                    @if (!laChinhMinh)
                                    {
                                        <form asp-action="DoiTrangThai" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-ghost btn-icon" title="@(item.TrangThai ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <span class="material-symbols-outlined">@(item.TrangThai ? "lock" : "lock_open")</span>
                                            </button>
                                        </form>
                                        @if (!item.CoDuLieuLienQuan)
                                        {
                                            <button type="button" class="btn btn-ghost btn-icon is-danger" title="Xóa tài khoản"
                                                    data-bs-toggle="modal" data-bs-target="#modalXoa"
                                                    data-id="@item.MaTaiKhoan" data-ten="@item.TenDangNhap">
                                                <span class="material-symbols-outlined">delete</span>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <span>Tổng số: @Model.Items.Count tài khoản</span>
            </div>
        </div>
    }
}

<div class="modal fade" id="modalXoa" tabindex="-1" aria-labelledby="modalXoaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <div class="modal-header">
                    <h3 class="modal-title" id="modalXoaTitle">Xóa tài khoản</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn xóa tài khoản <strong id="xoaTen"></strong>? Hành động này không thể hoàn tác.</p>
                    <input type="hidden" name="id" id="xoaId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xóa tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalXoa').addEventListener('show.bs.modal', function (e) {
            var nut = e.relatedTarget;
            document.getElementById('xoaId').value = nut.getAttribute('data-id');
            document.getElementById('xoaTen').textContent = nut.getAttribute('data-ten');
        });
    </script>
}
