@* Họ tên: Nguyễn Văn Hoàng - Lớp: TI17A4HN - Nhóm: UNETI01 *@
@* Module 1: Quản lý Hệ thống & Danh mục dùng chung - DangNhap.cshtml *@
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.DangNhapViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <div class="auth-container">
        <!-- Avatar profile badge -->
        <div class="auth-avatar-circle" aria-hidden="true">
            <svg class="auth-avatar-svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="24" cy="15" r="7.5" />
                <path d="M10 40c0-7.732 6.268-14 14-14s14 6.268 14 14" />
            </svg>
        </div>

        <!-- Heading -->
        <h1 class="auth-heading">CUSTOMER LOGIN</h1>

        <div class="auth-box">
            @if (TempData["ThanhCong"] is string thanhCong)
            {
                <div class="auth-alert auth-alert-success" role="alert">@thanhCong</div>
            }

            <form asp-action="DangNhap" method="post" autocomplete="on">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email ID / Tên đăng nhập -->
                <div class="auth-field">
                    <div class="auth-input-wrap">
                        <span class="auth-input-icon" aria-hidden="true">
                            <svg class="auth-input-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2" />
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                            </svg>
                        </span>
                        <input asp-for="TenDangNhap" class="auth-input-underline" placeholder="Email ID / Tên đăng nhập" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="auth-error-msg"></span>
                </div>

                <!-- Password / Mật khẩu -->
                <div class="auth-field">
                    <div class="auth-input-wrap">
                        <span class="auth-input-icon" aria-hidden="true">
                            <svg class="auth-input-svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                            </svg>
                        </span>
                        <input asp-for="MatKhau" type="password" class="auth-input-underline" placeholder="Password / Mật khẩu" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="MatKhau" class="auth-error-msg"></span>
                </div>

                <!-- Remember me & Forgot Password -->
                <div class="auth-options">
                    <label class="auth-checkbox-label" for="RememberMe">
                        <input asp-for="RememberMe" id="RememberMe" type="checkbox" />
                        <span>Remember me</span>
                    </label>
                    <a href="javascript:void(0)" class="auth-forgot-password" onclick="alert('Vui lòng liên hệ Quản trị viên (Admin) để được hỗ trợ cấp lại mật khẩu.')">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-submit-btn">LOGIN</button>
            </form>

            <div class="auth-system-brand">
                <span>MaintainPro &bull; Quản lý bảo trì thiết bị</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
