@* Họ tên: Nguyễn Khắc Hiếu | MSSV: 23103100225 | Nội dung: Module 5 - STT 57: Thêm mới vật tư vào kho *@
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.VatTuFormViewModel
@{
    ViewData["Title"] = "Thêm vật tư mới";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Kho vật tư</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0">Thêm vật tư mới vào kho</h1>
        <p class="text-muted mb-0">Nhập thông tin vật tư, định giá gợi ý và số lượng nhập kho ban đầu.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <span class="material-symbols-outlined align-middle me-1">arrow_back</span>
            Quay lại danh sách
        </a>
    </div>
</div>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

    <partial name="_Form" model="Model" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">
            <span class="material-symbols-outlined align-middle me-1">save</span>
            Lưu vào kho
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
