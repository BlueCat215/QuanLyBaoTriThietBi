@* Họ tên: Nguyễn Minh Đức - Lớp: TI17A4HN - Nhóm: UNETI01 *@
@* Module 2: In tem nhãn tài sản dán thiết bị *@
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Helpers
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Models.Enums
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.ThietBiTemNhanViewModel
@{
    Layout = null;
    var tb = Model.ThietBi;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In tem nhãn - @tb.TenThietBi (@tb.SoSerial)</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Be Vietnam Pro", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-color: #e2e8f0;
            color: #0f172a;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            min-height: 100vh;
        }

        /* --- THANH ĐIỀU KHIỂN (RESPONSIVE) --- */
        .no-print-bar {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px 32px;
            margin-bottom: 40px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            width: 100%;
            max-width: 800px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        }

        .bar-info h3 {
            font-size: 18px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .bar-info p {
            font-size: 14px;
            color: #64748b;
        }

        .bar-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            font-size: 15px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            border: none;
            transition: all 0.2s ease;
        }

        .btn svg {
            flex-shrink: 0;
        }

        .btn-primary {
            background: #2563eb;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        .btn-primary:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        .btn-secondary {
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
        }

        .btn-secondary:hover {
            background: #e2e8f0;
        }

        /* --- VÙNG HIỂN THỊ TRƯỚC (PREVIEW CONTAINER) --- */
        .preview-wrapper {
            background: #ffffff;
            width: 100%;
            max-width: 800px;
            border-radius: 20px;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
            min-height: 450px;
            overflow: hidden;
        }

        /* --- KHUNG TEM NHÃN (CHUẨN KÍCH THƯỚC IN 80x50mm) --- */
        .asset-label {
            width: 80mm;
            height: 50mm;
            background: #ffffff;
            border: 2.5px solid #0f172a;
            border-radius: 6px;
            padding: 3.5mm 4mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            transform: scale(1.8);
            transform-origin: center;
        }

        .label-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 2mm;
        }

        .brand-title {
            font-size: 11pt;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #1d4ed8;
        }

        .badge-code {
            font-family: "JetBrains Mono", Consolas, "Courier New", monospace;
            font-size: 9.5pt;
            font-weight: 700;
            background: #0f172a;
            color: #ffffff;
            padding: 2px 8px;
            border-radius: 4px;
        }

        .label-body {
            display: flex;
            align-items: center;
            gap: 4mm;
            margin-top: 2.5mm;
            flex: 1;
        }

        .qr-box {
            width: 26mm;
            height: 26mm;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            padding: 1mm;
        }

        .qr-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .info-box {
            flex: 1;
            font-size: 8.5pt;
            line-height: 1.4;
        }

        .info-row {
            margin-bottom: 1.5mm;
            display: flex;
        }

        .info-row:last-child {
            margin-bottom: 0;
        }

        .info-label {
            font-weight: 600;
            color: #475569;
            width: 17mm;
            flex-shrink: 0;
        }

        .info-value {
            font-weight: 700;
            color: #0f172a;
            word-break: break-word;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .info-value.serial {
            font-family: "JetBrains Mono", Consolas, "Courier New", monospace;
            color: #dc2626;
            font-size: 9pt;
        }

        .label-footer {
            border-top: 1.5px dashed #cbd5e1;
            padding-top: 1.5mm;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 7pt;
            font-weight: 500;
            color: #64748b;
        }

        /* --- RESPONSIVE CHO MÀN HÌNH NHỎ --- */
        @@media (max-width: 768px) {
            .asset-label {
                transform: scale(1.3);
            }

            .preview-wrapper {
                min-height: 350px;
                padding: 40px 20px;
            }

            .no-print-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .bar-actions {
                width: 100%;
                justify-content: space-between;
            }

            .btn {
                flex: 1;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .asset-label {
                transform: scale(1);
            }

            .preview-wrapper {
                min-height: 250px;
                padding: 20px;
            }

            .bar-actions {
                flex-direction: column;
            }
        }

        /* --- ĐỊNH DẠNG CHUẨN KHI IN MÁY IN NHIỆT (LOẠI BỎ SCALE, VỀ ĐÚNG MM) --- */
        @@media print {
            @@page {
                size: 80mm 50mm;
                margin: 0;
            }

            body {
                background: none;
                padding: 0;
                margin: 0;
                display: block;
            }

            .no-print-bar,
            .preview-wrapper {
                background: transparent;
                box-shadow: none;
                border: none;
                padding: 0;
                margin: 0;
                min-height: auto;
            }

            .no-print-bar {
                display: none !important;
            }

            .asset-label {
                transform: scale(1) !important;
                border: 2px solid #000000;
                box-shadow: none;
                page-break-inside: avoid;
                margin: 0;
            }
        }
    </style>
</head>

<body>

    <div class="no-print-bar">
        <div class="bar-info">
            <h3>Mẫu in tem nhãn tài sản dán thiết bị</h3>
            <p>Khổ tem chuẩn: 80mm x 50mm. Đã phóng to bản xem trước.</p>
        </div>
        <div class="bar-actions">
            <a class="btn btn-secondary" href="@Url.Action("Details", "ThietBi", new { id = tb.MaThietBi })">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Trở lại</span>
            </a>
            <button class="btn btn-primary" onclick="window.print()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>In ngay</span>
            </button>
        </div>
    </div>

    <!-- KHUNG WRAPPER ĐỂ PHÓNG TO TRÊN MÀN HÌNH -->
    <div class="preview-wrapper">
        <!-- KHUNG TEM NHÃN -->
        <div class="asset-label">
            <div class="label-header">
                <span class="brand-title">MaintainPro · UNETI</span>
                <span class="badge-code">@UiHelper.Ma("TB", tb.MaThietBi)</span>
            </div>

            <div class="label-body">
                <div class="qr-box">
                    <img src="@Model.QrCodeDataUri" alt="Mã QR thiết bị" />
                </div>
                <div class="info-box">
                    <div class="info-row">
                        <span class="info-label">Tên máy:</span>
                        <span class="info-value" title="@tb.TenThietBi">@tb.TenThietBi</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Serial:</span>
                        <span class="info-value serial">@tb.SoSerial</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Loại máy:</span>
                        <span class="info-value">@(tb.LoaiThietBi?.TenLoaiThietBi ?? "—")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Khu vực:</span>
                        <span class="info-value">@(tb.KhuVuc?.TenKhuVuc ?? "—")</span>
                    </div>
                </div>
            </div>

            <div class="label-footer">
                <span>Quét QR để xem lý lịch & báo sự cố</span>
                <span>In: @Model.NgayIn.ToString("dd/MM/yy")</span>
            </div>
        </div>
    </div>

</body>

</html>
