@*  Sửa Thiết bị *@
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.ThietBiFormViewModel
@{
    ViewData["Title"] = "Sửa thiết bị";
}

<div class="page-header">
    <div>
        <h1>Sửa thiết bị</h1>
        <p>Cập nhật thông tin thiết bị. Để đổi tình trạng, dùng mục "Đổi tình trạng" ở trang chi tiết.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.MaThietBi" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="MaThietBi" />
                    <partial name="_Form" model="Model" />
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" asp-action="Details"
                           asp-route-id="@Model.MaThietBi">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="mb-3">Ảnh hiện tại (@Model.DanhSachAnhHienTai.Count)</h3>
                @if (Model.DanhSachAnhHienTai.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có ảnh thực tế nào. Bạn có thể chọn tải lên ở form bên cạnh.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var anh in Model.DanhSachAnhHienTai)
                        {
                            <div class="d-flex align-items-center gap-3 p-2 border rounded bg-light">
                                <img src="@anh.DuongDanFile" alt="@anh.TenFileGoc"
                                     style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px;" />
                                <div class="flex-grow-1 text-truncate">
                                    <div class="fw-semibold text-truncate" title="@anh.TenFileGoc">@anh.TenFileGoc</div>
                                    <div class="text-muted small">@anh.NgayUpload.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <form asp-action="XoaAnh" asp-route-id="@Model.MaThietBi" method="post"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa ảnh này?');">
                                    <input type="hidden" name="maTepDinhKem" value="@anh.MaTepDinhKem" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Edit", new { id = Model.MaThietBi })" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa ảnh">
                                        <span class="material-symbols-outlined icon-18">delete</span>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
