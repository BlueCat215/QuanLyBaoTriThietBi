@* Danh sách Thiết bị: Tìm kiếm + Lọc + Sắp xếp + Phân trang *@
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Helpers
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Models.Enums
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.ThietBiIndexViewModel
@{
    ViewData["Title"] = "Thiết bị";
    var bl = Model.BoLoc;
    var duongDanHienTai = Context.Request.Path + Context.Request.QueryString;
    var coThayDoi = Model.CoBoLoc || bl.SapXep != ThietBiSapXep.TenAZ;
    var coQuyenQuanLy = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.KyThuatVien);
}

<div class="page-header">
    <div>
        <h1>Thiết bị</h1>
        <p>Quản lý danh sách thiết bị, tình trạng và hạn bảo trì.</p>
    </div>
    @if (coQuyenQuanLy)
    {
        <div class="page-actions">
            <a class="btn btn-primary" asp-action="Create">Thêm thiết bị</a>
        </div>
    }
</div>

@if (Model.PagedItems.TotalItems == 0 && !coThayDoi)
{
    <div class="card">
        <div class="card-body empty-state">
            <span class="material-symbols-outlined icon-24">precision_manufacturing</span>
            <h3>Chưa có thiết bị nào</h3>
            <p>Hãy thêm thiết bị đầu tiên để bắt đầu theo dõi bảo trì.</p>
            @if (coQuyenQuanLy)
            {
                <a class="btn btn-primary" asp-action="Create">Thêm thiết bị</a>
            }
        </div>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="filter-bar">
        @* Đặt lại trang về 1 khi bấm Tìm kiếm / Áp dụng bộ lọc mới *@
        <input type="hidden" name="Trang" value="1" />

        <div class="search">
            <label class="form-label" for="TuKhoa">Tìm kiếm</label>
            <input id="TuKhoa" name="TuKhoa" value="@bl.TuKhoa" class="form-control"
                   placeholder="Tên thiết bị, số serial hoặc tên khu vực" />
        </div>

        <div>
            <label class="form-label" for="MaLoaiThietBi">Loại thiết bị</label>
            <select id="MaLoaiThietBi" name="MaLoaiThietBi" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var loai in Model.LoaiDeLoc)
                {
                    <option value="@loai.Ma" selected="@(bl.MaLoaiThietBi == loai.Ma)">@loai.Ten</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" for="MaKhuVuc">Khu vực</label>
            <select id="MaKhuVuc" name="MaKhuVuc" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var kv in Model.KhuVucDeLoc)
                {
                    <option value="@kv.Ma" selected="@(bl.MaKhuVuc == kv.Ma)">@kv.Ten</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" for="TinhTrang">Tình trạng</label>
            <select id="TinhTrang" name="TinhTrang" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var v in Enum.GetValues<TinhTrangThietBiEnum>())
                {
                    <option value="@v" selected="@(bl.TinhTrang == v)">@UiHelper.Badge(v).Text</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" for="HanBaoTri">Hạn bảo trì</label>
            <select id="HanBaoTri" name="HanBaoTri" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var v in Enum.GetValues<TrangThaiHanBaoTriEnum>())
                {
                    <option value="@v" selected="@(bl.HanBaoTri == v)">
                        @ThietBiBoLocText.HanBaoTri(v, UiHelper.NgayCanhBaoSapDenHan)
                    </option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" for="NgaySuDungTu">Đưa vào sử dụng từ</label>
            <input id="NgaySuDungTu" name="NgaySuDungTu" type="date" class="form-control"
                   value="@(bl.NgaySuDungTu?.ToString("yyyy-MM-dd"))" />
        </div>

        <div>
            <label class="form-label" for="NgaySuDungDen">Đến ngày</label>
            <input id="NgaySuDungDen" name="NgaySuDungDen" type="date" class="form-control"
                   value="@(bl.NgaySuDungDen?.ToString("yyyy-MM-dd"))" />
        </div>

        <div>
            <label class="form-label" for="SapXep">Sắp xếp</label>
            <select id="SapXep" name="SapXep" class="form-select">
                @foreach (var v in Enum.GetValues<ThietBiSapXep>())
                {
                    <option value="@v" selected="@(bl.SapXep == v)">@ThietBiBoLocText.SapXep(v)</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Áp dụng</button>
            @if (coThayDoi)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Xóa bộ lọc</a>
            }
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.CanhBao))
    {
        <div class="alert alert-warning" role="alert">@Model.CanhBao</div>
    }

    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="card-body empty-state">
                <span class="material-symbols-outlined icon-24">search_off</span>
                <h3>Không tìm thấy thiết bị phù hợp</h3>
                <p>Không có thiết bị nào khớp với các điều kiện đã chọn. Hãy thử bỏ bớt bộ lọc.</p>
                <a class="btn btn-outline-secondary" asp-action="Index">Xóa bộ lọc</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Thiết bị</th>
                        <th>Loại thiết bị</th>
                        <th>Khu vực</th>
                        <th>Tình trạng</th>
                        <th>Bảo trì tiếp theo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var ngung = item.TinhTrang == TinhTrangThietBiEnum.NgungSuDung;
                        <tr class="@(ngung ? "is-muted" : "")">
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaThietBi"
                                   class="cell-title text-decoration-none">@item.TenThietBi</a>
                                <div class="cell-sub mono">@item.SoSerial</div>
                            </td>
                            <td>@item.TenLoaiThietBi</td>
                            <td>@item.TenKhuVuc</td>
                            <td>
                                <partial name="_StatusBadge" model="UiHelper.Badge(item.TinhTrang)" />
                            </td>
                            <td>
                                @if (ngung)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    var (badge, ghiChu) = UiHelper.HanBaoTri(item.NgayBaoTriTiepTheo);
                                    <div>@UiHelper.Ngay(item.NgayBaoTriTiepTheo)</div>
                                    <partial name="_StatusBadge" model="badge" />
                                    <span class="cell-sub">@ghiChu</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn btn-ghost btn-icon" asp-action="Details" asp-route-id="@item.MaThietBi"
                                       title="Xem chi tiết">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </a>
                                    @if (coQuyenQuanLy)
                                    {
                                        @if (!ngung)
                                        {
                                            <a class="btn btn-ghost btn-icon" asp-action="Edit" asp-route-id="@item.MaThietBi"
                                               title="Sửa thiết bị">
                                                <span class="material-symbols-outlined">edit</span>
                                            </a>
                                        }
                                        <form asp-action="DoiTinhTrang" asp-route-id="@item.MaThietBi" method="post" class="d-inline">
                                            <input type="hidden" name="tinhTrang"
                                                   value="@(ngung ? nameof(TinhTrangThietBiEnum.DangHoatDong) : nameof(TinhTrangThietBiEnum.NgungSuDung))" />
                                            <input type="hidden" name="returnUrl" value="@duongDanHienTai" />
                                            <button type="submit" class="btn btn-ghost btn-icon"
                                                    title="@(ngung ? "Kích hoạt lại" : "Ngừng sử dụng")">
                                                <span class="material-symbols-outlined">@(ngung ? "check_circle" : "block")</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <div>
                    <span>
                        @if (Model.CoBoLoc)
                        {
                            <text>Tìm thấy <strong>@Model.PagedItems.TotalItems</strong> thiết bị phù hợp</text>
                        }
                        else
                        {
                            <text>Tổng số: <strong>@Model.PagedItems.TotalItems</strong> thiết bị</text>
                        }
                    </span>
                    @if (Model.PagedItems.TotalPages > 1)
                    {
                        <span class="text-muted ms-2">(Trang @Model.PagedItems.Page / @Model.PagedItems.TotalPages)</span>
                    }
                </div>

                @if (Model.PagedItems.TotalPages > 1)
                {
                    <nav aria-label="Phân trang thiết bị">
                        <ul class="pagination">
                            @* Nút Trang trước *@
                            <li class="page-item @(!Model.PagedItems.HasPrevious ? "disabled" : "")">
                                @if (Model.PagedItems.HasPrevious)
                                {
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-all-route-data="@bl.ToRouteValues(Model.PagedItems.Page - 1)"
                                       aria-label="Trang trước">
                                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">chevron_left</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link" aria-hidden="true">
                                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">chevron_left</span>
                                    </span>
                                }
                            </li>

                            @{
                                var curPage = Model.PagedItems.Page;
                                var totalP = Model.PagedItems.TotalPages;
                                var startP = Math.Max(1, curPage - 2);
                                var endP = Math.Min(totalP, curPage + 2);
                            }

                            @if (startP > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-all-route-data="@bl.ToRouteValues(1)">1</a>
                                </li>
                                @if (startP > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                            }

                            @for (var p = startP; p <= endP; p++)
                            {
                                <li class="page-item @(p == curPage ? "active" : "")">
                                    @if (p == curPage)
                                    {
                                        <span class="page-link">@p</span>
                                    }
                                    else
                                    {
                                        <a class="page-link" asp-action="Index" asp-all-route-data="@bl.ToRouteValues(p)">@p</a>
                                    }
                                </li>
                            }

                            @if (endP < totalP)
                            {
                                @if (endP < totalP - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-all-route-data="@bl.ToRouteValues(totalP)">@totalP</a>
                                </li>
                            }

                            @* Nút Trang sau *@
                            <li class="page-item @(!Model.PagedItems.HasNext ? "disabled" : "")">
                                @if (Model.PagedItems.HasNext)
                                {
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-all-route-data="@bl.ToRouteValues(Model.PagedItems.Page + 1)"
                                       aria-label="Trang sau">
                                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">chevron_right</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link" aria-hidden="true">
                                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">chevron_right</span>
                                    </span>
                                }
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        var oSapXep = document.getElementById('SapXep');
        if (oSapXep) oSapXep.addEventListener('change', function () { this.form.submit(); });
    </script>
}
