@* Họ tên: Nguyễn Khắc Hiếu | MSSV: 23103100225 | Nội dung: Module 5 - STT 58: Form nhập chi tiết xử lý tích hợp xuất kho vật tư và snapshot tên *@
@using System.Globalization
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.ChiTietXuLyFormViewModel

<div class="mb-3">
    <label asp-for="NoiDungThucHien" class="form-label required"></label>
    <textarea asp-for="NoiDungThucHien" class="form-control" rows="3"
              placeholder="Ví dụ: Tháo vệ sinh dàn lạnh, thay tụ khởi động"></textarea>
    <span asp-validation-for="NoiDungThucHien"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="MaVatTu" class="form-label">Vật tư trong kho (STT 58)</label>
        <select asp-for="MaVatTu" class="form-select">
            <option value="">-- Không chọn (nhập tay linh kiện tự do bên cạnh) --</option>
            @foreach (var v in Model.VatTuOptions)
            {
                var tinhTrang = v.SoLuongTon <= 0 
                    ? "❌ [HẾT HÀNG]" 
                    : (v.SoLuongTon <= 5 ? $"⚠️ [SẮP HẾT: còn {v.SoLuongTon}]" : $"✅ [Còn {v.SoLuongTon}]");
                <option value="@v.Ma" selected="@(Model.MaVatTu == v.Ma)"
                        data-ten="@v.Ten" 
                        data-dongia="@v.DonGia.ToString("0.##", CultureInfo.InvariantCulture)"
                        data-tonkho="@v.SoLuongTon"
                        data-donvitinh="@v.DonViTinh">
                    @v.Ten (@v.DonViTinh) - @tinhTrang
                </option>
            }
        </select>
        <div id="thongBaoTonKho" class="small mt-1 d-none"></div>
        <div class="form-text">Chọn vật tư từ kho để tự động trừ tồn kho và snapshot tên vật tư bảo toàn lịch sử.</div>
        <span asp-validation-for="MaVatTu"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="VatTuLinhKien" class="form-label">Tên vật tư / Linh kiện (Snapshot lịch sử)</label>
        <input asp-for="VatTuLinhKien" class="form-control" placeholder="Ví dụ: Tụ khởi động 35µF" />
        <div class="form-text">Tên được lưu dạng snapshot để bảo toàn lịch sử dù sau này danh mục kho có thay đổi.</div>
        <span asp-validation-for="VatTuLinhKien"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="SoLuong" class="form-label"></label>
        <input asp-for="SoLuong" type="number" min="1" step="1" class="form-control num" />
        <span asp-validation-for="SoLuong"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DonGia" class="form-label"></label>
        @* Không dùng asp-for để value luôn là số nguyên theo dạng invariant (tránh lệch dấu thập phân/nghìn theo culture máy chủ) *@
        <input id="DonGia" name="DonGia" type="number" min="0" step="1" class="form-control num"
               value="@(Model.DonGia?.ToString("0", CultureInfo.InvariantCulture))" />
        <span asp-validation-for="DonGia"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="thanhTienXemTruoc">Thành tiền (tạm tính)</label>
        <div id="thanhTienXemTruoc" class="form-control num" aria-live="polite">—</div>
        <div class="form-text">Hệ thống tự tính = Số lượng × Đơn giá khi lưu, không nhập tay.</div>
    </div>
</div>

<div class="mb-4">
    <label asp-for="GhiChu" class="form-label"></label>
    <input asp-for="GhiChu" class="form-control" />
    <span asp-validation-for="GhiChu"></span>
</div>
