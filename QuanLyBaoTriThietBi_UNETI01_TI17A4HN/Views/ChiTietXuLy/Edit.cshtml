@* Họ tên: Nguyễn Khắc Hiếu | MSSV: <23103100225> | Nội dung: Module 5 - Sửa chi tiết xử lý *@
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.ChiTietXuLyFormViewModel
@{
    ViewData["Title"] = "Sửa chi tiết xử lý";
    var phieu = Model.Phieu!;
}

<div class="page-header">
    <div>
        <h1>Sửa chi tiết xử lý</h1>
        <p>Cập nhật dòng chi tiết của phiếu <span class="mono">@UiHelper.Ma("PX", phieu.MaPhieuXuLy)</span> · @(phieu.TenThietBi ?? "—") · @phieu.NguonText</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.MaChiTiet" method="post">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="MaChiTiet" />
                    <input type="hidden" asp-for="MaPhieuXuLy" />
                    <partial name="_Form" model="Model" />
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" asp-action="TheoPhieu" asp-route-maPhieu="@phieu.MaPhieuXuLy">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FormScripts" />
}
