@* Họ tên: Phạm Việt Hoàn | MSSV: 23103100207 | Nội dung: Module 3 - Sửa kế hoạch bảo trì *@
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.KeHoachBaoTriFormViewModel
@{
    ViewData["Title"] = "Sửa kế hoạch bảo trì";
}

<div class="page-header">
    <div>
        <h1>Sửa kế hoạch bảo trì</h1>
        <p><span class="mono">@UiHelper.Ma("KH", Model.MaKeHoach)</span> · Chỉ sửa được khi kế hoạch Chờ thực hiện hoặc Đã phân công.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.MaKeHoach" method="post">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="MaKeHoach" />
                    <partial name="_Form" model="Model" />
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
