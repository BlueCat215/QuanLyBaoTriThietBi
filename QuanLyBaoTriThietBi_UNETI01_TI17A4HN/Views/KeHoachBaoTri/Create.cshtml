@* Họ tên: Phạm Việt Hoàn | MSSV: 23103100207 | Nội dung: Module 3 - Thêm kế hoạch bảo trì *@
@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.ViewModels.KeHoachBaoTriFormViewModel
@{
    ViewData["Title"] = "Thêm kế hoạch bảo trì";
}

<div class="page-header">
    <div>
        <h1>Thêm kế hoạch bảo trì</h1>
        <p>Lập kế hoạch bảo trì định kỳ cho thiết bị. Kế hoạch mới luôn ở trạng thái Chờ thực hiện.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="MaKeHoach" />
                    <partial name="_Form" model="Model" />
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu kế hoạch</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
