@using System.Security.Claims
@using QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Models.Enums
@{
    // Thong tin nguoi dung lay tu Claims. SV1 khi viet dang nhap PHAI them claim "HoTen" va ClaimTypes.Role (= ten VaiTroEnum).
    var hoTen = User.FindFirst("HoTen")?.Value ?? User.Identity?.Name ?? "Khách";
    var vaiTro = User.FindFirst(ClaimTypes.Role)?.Value;
    var vaiTroText = Enum.TryParse<VaiTroEnum>(vaiTro, out var vt) ? UiHelper.Badge(vt).Text : "";
    var tieuDe = ViewData["Title"] as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(tieuDe) ? "" : tieuDe + " - ")MaintainPro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyBaoTriThietBi_UNETI01_TI17A4HN.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <partial name="_Sidebar" />

        <div class="app-main">
            <header class="app-header">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" id="sidebarToggle" class="btn btn-ghost btn-icon d-md-none" title="Mở menu" aria-label="Mở menu">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                            @if (!string.IsNullOrEmpty(tieuDe))
                            {
                                <li class="breadcrumb-item active" aria-current="page">@tieuDe</li>
                            }
                        </ol>
                    </nav>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar" title="@hoTen">@UiHelper.VietTat(hoTen)</span>
                    <span class="d-none d-sm-block text-small fw-semibold">@hoTen</span>
                </div>
            </header>

            <main class="app-content" role="main">
                @* Thong bao ket qua: controller gan TempData["ThanhCong"] = "Da luu thiet bi thanh cong."  hoac TempData["Loi"] = "..." *@
                @if (TempData["ThanhCong"] is string thanhCong)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @thanhCong
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }
                @if (TempData["Loi"] is string loi)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @loi
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Mobile: nut ☰ mo/dong sidebar dang drawer
        (function () {
            var sb = document.querySelector('.sidebar'), btn = document.getElementById('sidebarToggle');
            if (!sb || !btn) return;
            btn.addEventListener('click', function () { sb.classList.toggle('is-open'); });
            document.addEventListener('click', function (e) {
                if (sb.classList.contains('is-open') && !sb.contains(e.target) && !btn.contains(e.target)) sb.classList.remove('is-open');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
