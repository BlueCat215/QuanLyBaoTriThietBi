@model QuanLyBaoTriThietBi_UNETI01_TI17A4HN.Models.LoaiThietBi
@{
    ViewData["Title"] = "Sửa loại thiết bị";
}

<div class="page-header">
    <div>
        <h1>Sửa loại thiết bị</h1>
        <p>Cập nhật thông tin loại thiết bị.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.MaLoaiThietBi" method="post">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="MaLoaiThietBi" />
                    <partial name="_Form" model="Model" />
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
